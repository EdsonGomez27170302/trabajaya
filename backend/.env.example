PORT=3001

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=trabajaya
DB_SSLMODE=disable
AUTO_MIGRATE=true

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_HOURS=72

# Gmail SMTP (STARTTLS, puerto 587). Deja SMTP_USER/SMTP_PASSWORD vacíos para
# que el backend solo loguee el link de verificación por consola (modo dev).
# Para correo real: SMTP_USER = tu correo de Gmail, SMTP_PASSWORD = una
# "contraseña de aplicación" generada en https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@trabajaya.pe

FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
INSTITUTIONAL_EMAIL_DOMAIN=unsch.edu.pe
UPLOADS_DIR=./uploads
